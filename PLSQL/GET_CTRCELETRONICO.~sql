enabled: filters?.codModelo == '57_S',

SELECT
    CTRC.ID_CTE                  AS ID,
    CTRC.SERIE,
    CTRC.DATA_EMISSAO,
    CTRC.CHAVEDEACESSO           AS CHAVE_ACESSO,
    CTRC.CONHECIMENTO            AS NUMERO,
    CTRC.STATUS,
    CTRC.CONTEUDO_CLOB,
    CTRC.CONTEUDO                AS CONTEUDO_XML,
    CTRC.SISTEMA,

    FTA.RECNUM                   AS MANUT_CODIGO,
    FTA.ID_CTE                   AS MANUT_ID_CTE,
    FTA.SERIE                    AS MANUT_SERIE,

    SAI.CODDOCTOESF              AS SAI_COD_DOCTO,
    SAI.VLCONTABILSAIDA          AS SAI_VL_CONTABIL,
    SAI.VLSERVICOSAIDA           AS SAI_VL_SERVICO,
    SAI.VALORNF                  AS SAI_VALOR_NF,
    SAI.ICMSVALORSAIDA           AS SAI_VALOR_ICMS,
    SAI.IPIVALORSAIDA            AS SAI_VALOR_IPI,
    VW_SAI.CODIGOEMPRESA         AS SAIFIL_COD_EMP,
    VW_SAI.CODIGOFL              AS SAIFIL_COD_FIL,
    VW_SAI.RSOCIALEMPRESA        AS SAIFIL_RSOCIAL,
    VW_SAI.INSCRICAOEMPRESA      AS SAIFIL_INSCRICAO
FROM BGM_CTRC_ELETRONICO CTRC
    LEFT JOIN FTA001 FTA         ON FTA.ID_CTE = CTRC.ID_CTE
    LEFT JOIN ESFSAIDA SAI       ON SAI.ID_CTE = CTRC.ID_CTE
    LEFT JOIN VW_FILIAL VW_SAI   ON VW_SAI.CODIGOEMPRESA = SAI.CODIGOEMPRESA AND VW_SAI.CODIGOFL = SAI.CODIGOFL
WHERE 1=1	
ORDER BY CTRC.ID_CTE;