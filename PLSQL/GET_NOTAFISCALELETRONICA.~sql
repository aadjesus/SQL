SELECT
    NFE.ID_NFE                   AS ID,
    NFE.NUMERONFE                AS NUMERO,
    NFE.DATAEMISSAO              AS DATA_EMISSAO,
    NFE.CHAVEDEACESSO            AS CHAVE_ACESSO,
    NFE.STATUS,
    NFE.CONTEUDO_CLOB,
    NFE.CONTEUDONF               AS CONTEUDO,
    NFE.SISTEMA,
    BNF.CODINTNF                 AS BGMNF_CODIGO,
    BNF.VALORTOTALNF             AS BGMNF_VALOR_TOTAL,
    BGM_INT.SEQUENCIA            AS BGMINT_SEQUENCIA,
    VW_BNF.CODIGOEMPRESA         AS BGMNFFIL_COD_EMP,
    VW_BNF.CODIGOFL              AS BGMNFFIL_COD_FIL,
    VW_BNF.RSOCIALEMPRESA        AS BGMNFFIL_RSOCIAL,
    VW_BNF.INSCRICAOEMPRESA      AS BGMNFFIL_INSCRICAO,
    VW_BNF.NOMEFANTASIAEMPRESA   AS BGMNFFIL_NOMEFANTASIA,

    MAT.CODINTNFAVUL             AS MAT_CODIGO,

    NFAVUL.CODINTNF              AS NFAVUL_ID,
    NFAVUL.NUMERONF              AS NFAVUL_NUMERO_NF,
    NFAVUL.VALORICMSNF           AS NFAVUL_VALOR_ICMS,

    FRE.CODINTNF                 AS FRE_CODIGO,
    FRE.VALORLIQUIDO             AS FRE_VALOR_LIQUIDO,

    TUR.CODINTNF                 AS TUR_CODIGO,
    TUR.VALORTOTALNF             AS TUR_VALOR_TOTAL,
    SAI.CODDOCTOESF              AS TURSAI_COD_DOCTO,
    SAI.CODIGOEMPRESA            AS TURSAI_COD_EMP,
    SAI.CODIGOFL                 AS TURSAI_COD_FIL,
    SAI.NRDOCSAIDA               AS TURSAI_NR_DOC,
    SAI.ITEMSAIDA                AS TURSAI_ITEM,
    SAI.VALORNF                  AS TURSAI_VALOR_NF,
    SAI.ICMSVALORSAIDA           AS TURSAI_VALOR_ICMS,
    SAI.IPIVALORSAIDA            AS TURSAI_VALOR_IPI,
    VW_TS.CODIGOEMPRESA          AS TURSAIFIL_COD_EMP,
    VW_TS.CODIGOFL               AS TURSAIFIL_COD_FIL,
    VW_TS.RSOCIALEMPRESA         AS TURSAIFIL_RSOCIAL,
    VW_TS.INSCRICAOEMPRESA       AS TURSAIFIL_INSCRICAO,
    VW_TS.NOMEFANTASIAEMPRESA    AS TURSAIFIL_NOMEFANTASIA,
    VW_TUR.CODIGOEMPRESA         AS TURFIL_COD_EMP,
    VW_TUR.CODIGOFL              AS TURFIL_COD_FIL,
    VW_TUR.RSOCIALEMPRESA        AS TURFIL_RSOCIAL,
    VW_TUR.INSCRICAOEMPRESA      AS TURFIL_INSCRICAO,
    VW_TUR.NOMEFANTASIAEMPRESA   AS TURFIL_NOMEFANTASIA,

    ENF.CODINTNF                 AS ESFNF_CODIGO,
    ENF.VALORTOTAL               AS ESFNF_VALOR_TOTAL,
    VW_ENF.CODIGOEMPRESA         AS ESFNFFIL_COD_EMP,
    VW_ENF.CODIGOFL              AS ESFNFFIL_COD_FIL,
    VW_ENF.RSOCIALEMPRESA        AS ESFNFFIL_RSOCIAL,
    VW_ENF.INSCRICAOEMPRESA      AS ESFNFFIL_INSCRICAO,
    VW_ENF.NOMEFANTASIAEMPRESA   AS ESFNFFIL_NOMEFANTASIA,
    SAI_NF.VLCONTABILSAIDA       AS ESFNFSAI_VL_CONTABIL,
    SAI_NF.CODDOCTOESF           AS ESFNFSAI_COD_DOCTO,
    SAI_NF.ICMSVALORSAIDA        AS ESFNFSAI_VALOR_ICMS,
    SAI_NF.IPIVALORSAIDA         AS ESFNFSAI_VALOR_IPI,
    VW_NS.CODIGOEMPRESA          AS ESFNFSAIFIL_COD_EMP,
    VW_NS.CODIGOFL               AS ESFNFSAIFIL_COD_FIL,
    VW_NS.RSOCIALEMPRESA         AS ESFNFSAIFIL_RSOCIAL,
    VW_NS.INSCRICAOEMPRESA       AS ESFNFSAIFIL_INSCRICAO,
    VW_NS.NOMEFANTASIAEMPRESA    AS ESFNFSAIFIL_NOMEFANTASIA
FROM BGM_NOTAFISCAL_ELETRONICA NFE
    LEFT JOIN BGM_NOTAFISCAL BNF        ON BNF.CODINTNF = NFE.CODINTNF_BGMNF
    LEFT JOIN BGM_NFINTEGRACAOESF BGM_INT ON BGM_INT.CODINTNF = BNF.CODINTNF
    LEFT JOIN VW_FILIAL VW_BNF          ON VW_BNF.CODIGOEMPRESA = BNF.CODIGOEMPRESA AND VW_BNF.CODIGOFL = BNF.CODIGOFL
    LEFT JOIN EST_MATERIALAVULSONF MAT  ON MAT.CODINTNFAVUL = NFE.CODINTNFAVUL
    LEFT JOIN FRE_NOTAFISCALAVULSA NFAVUL ON NFAVUL.CODINTNF = NFE.CODINTNF
    LEFT JOIN FREM_NOTAFISCAL FRE       ON FRE.CODINTNF = NFE.CODINTNF
    LEFT JOIN TUR_NOTAFISCAL TUR        ON TUR.CODINTNF = NFE.CODINTNF_ESFNF
    LEFT JOIN ESFSAIDA SAI              ON SAI.CODDOCTOESF = TUR.CODDOCTOESF
    LEFT JOIN VW_FILIAL VW_TS           ON VW_TS.CODIGOEMPRESA = SAI.CODIGOEMPRESA AND VW_TS.CODIGOFL = SAI.CODIGOFL
    LEFT JOIN VW_FILIAL VW_TUR          ON VW_TUR.CODIGOEMPRESA = TUR.CODIGOEMPRESA AND VW_TUR.CODIGOFL = TUR.CODIGOFL
    LEFT JOIN ESFNOTAFISCAL ENF         ON ENF.CHAVEDEACESSO = NFE.CHAVEDEACESSO
    LEFT JOIN VW_FILIAL VW_ENF          ON VW_ENF.CODIGOEMPRESA = ENF.CODIGOEMPRESA AND VW_ENF.CODIGOFL = ENF.CODIGOFL
    LEFT JOIN ESFSAIDA SAI_NF           ON SAI_NF.CODDOCTOESF = ENF.CODDOCTOESF
    LEFT JOIN VW_FILIAL VW_NS           ON VW_NS.CODIGOEMPRESA = SAI_NF.CODIGOEMPRESA AND VW_NS.CODIGOFL = SAI_NF.CODIGOFL
WHERE 1=1	
ORDER BY NFE.ID_NFE;